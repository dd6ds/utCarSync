From 73daef04e80167e112450b58309440d529e198ee Mon Sep 17 00:00:00 2001
From: dd6ds <dd6ds@eclipso.de>
Date: Wed, 4 Nov 2026 07:43:26 +0100
Subject: [PATCH 1/2] contactsservice: select contacts backend at runtime

The service always opened the org.nemomobile.contacts.sqlite backend.
On devices where the user's contacts are stored in address-book-service
(galera backend), e.g. Ubuntu Touch 24.04-2.x stable, the backend is
either not installed or empty, so PBAP clients (car kits) received an
empty phonebook.

Pick the backend when the service starts:
 1. $LOMIRI_OBEX_CONTACTS_BACKEND, if set
 2. qtcontacts-sqlite, if installed and not empty
 3. galera, if installed
 4. qtcontacts-sqlite as last resort

Tested on a Xiaomi Poco X3 Pro (vayu), 24.04-2.x stable, 174 contacts
in galera: obexd PBAP PullAll/List/Pull work from a BlueZ PCE (laptop)
and from a SEAT Leon (2019, VW MIB2 Standard by Technisat): contacts
are browsable in the car and incoming calls show the caller's name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PCCLepF6vdmVFK5L6Hvm95
---
 src/contactsservice.cpp | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/contactsservice.cpp b/src/contactsservice.cpp
index 6a222dd..68999bd 100644
--- a/src/contactsservice.cpp
+++ b/src/contactsservice.cpp
@@ -33,12 +33,45 @@ using namespace QtContacts;
 using namespace QtVersit;
 
 static const char *DEFAULT_BACKEND_NAME = "org.nemomobile.contacts.sqlite";
+static const char *LEGACY_BACKEND_NAME = "galera"; // address-book-service (UT 24.04-1.x)
+
+// Choose the QtContacts backend that actually holds the user's contacts.
+// 1. $LOMIRI_OBEX_CONTACTS_BACKEND, if set
+// 2. qtcontacts-sqlite, if installed and not empty
+// 3. galera (address-book-service), if installed
+// 4. qtcontacts-sqlite as last resort
+static QString selectBackend()
+{
+    const QString forced = qEnvironmentVariable("LOMIRI_OBEX_CONTACTS_BACKEND");
+    if (!forced.isEmpty()) {
+        qDebug() << "contacts backend forced by environment:" << forced;
+        return forced;
+    }
+
+    const QStringList available = QContactManager::availableManagers();
+    const QString sqlite = QString::fromLatin1(DEFAULT_BACKEND_NAME);
+    const QString legacy = QString::fromLatin1(LEGACY_BACKEND_NAME);
+    qDebug() << "available contacts backends:" << available;
+
+    if (available.contains(sqlite)) {
+        QContactManager probe(sqlite);
+        if (!probe.contactIds().isEmpty() || !available.contains(legacy)) {
+            return sqlite;
+        }
+        qDebug() << "qtcontacts-sqlite is empty, falling back to" << legacy;
+    }
+    if (available.contains(legacy)) {
+        return legacy;
+    }
+    return sqlite;
+}
 
 ContactsService::ContactsService(VersionStateStore &store, QObject *parent)
     : QObject(parent)
     , mStateStore(store)
-    , mManager(DEFAULT_BACKEND_NAME)
+    , mManager(selectBackend())
 {
+    qDebug() << "using contacts backend" << mManager.managerName();
 }
 
 uint ContactsService::Count(uint &count)
